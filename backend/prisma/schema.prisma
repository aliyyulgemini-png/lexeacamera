// =============================================================================
// SCHEMA FINAL (WAV Camera)
//
// Aturan uang: SEMUA nominal rupiah disimpan sebagai Int (tanpa desimal).
// Maksimal satu nilai = 2.147.483.647. SUM di SQL menghasilkan bigint/numeric.
//
// Setelah `prisma migrate dev --create-only`, tambahkan SQL manual ini ke
// file migration (Prisma tidak bisa mengungkapkannya di schema):
//
//   -- satu karyawan hanya boleh punya satu absen yang masih terbuka
//   -- (absen yang ditandai missed_checkout tidak dihitung terbuka)
//   CREATE UNIQUE INDEX "Attendance_one_open_per_employee"
//     ON "Attendance" ("employee_id")
//     WHERE "check_out_at" IS NULL AND "missed_checkout" = false;
//
//   -- nominal tidak boleh negatif / pembayaran harus positif
//   ALTER TABLE "Camera"    ADD CONSTRAINT "Camera_money_chk"
//     CHECK ("price" >= 0 AND "modal" >= 0 AND "strikethrough_price" >= 0);
//   ALTER TABLE "Order"     ADD CONSTRAINT "Order_money_chk"
//     CHECK ("total_amount" >= 0);
//   ALTER TABLE "OrderItem" ADD CONSTRAINT "OrderItem_money_chk"
//     CHECK ("camera_price" >= 0 AND "camera_modal" >= 0 AND "quantity" > 0);
//
//   -- paid_at wajib terisi jika dan hanya jika status PAID
//   ALTER TABLE "Order" ADD CONSTRAINT "Order_paid_at_chk"
//     CHECK (("payment_status" = 'PAID') = ("paid_at" IS NOT NULL));
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

enum ScheduleItemCategory {
  SHIFT // jam kerja (P, S, S3, LP, LS, PIK)
  LEAVE // cuti / izin (AL)
  OFF // libur (OFF)
  OTHER // lainnya (training, dinas luar, dll)
}

enum EntryMethod {
  CASH
  NON_CASH
}

datasource db {
  provider = "postgresql"
}

enum Condition {
  NEW
  SECOND
}

enum RemitType {
  CASH
  TRANSFER
}

enum Role {
  ADMIN
  OWNER
}

enum PayrollStatus {
  PENDING
  PAID
}

enum PaymentStatuses {
  DP
  PAID
  UNPAID
}

enum OrderType {
  SALE
  REFUND
}

enum QcSection {
  PHYSICAL
  FUNCTION
  ACCESSORY
  COMPLETENESS
}

enum QcClass {
  NORMAL
  MINOR
}

enum QcOrigin {
  ORIGINAL
  OEM
}

enum QcType {
  BUY
  SELL
}

enum QcStatus {
  DEAL
  CANCEL
}

enum QcMediaKind {
  PHOTO
  VIDEO
}

model Camera {
  id                  String                  @id @default(uuid())
  name                String
  price               Int
  condition           Condition               @default(NEW)
  stock               Int
  description         String                  @default("") @db.Text
  inclusions          String                  @default("") @db.Text
  promo               Boolean                 @default(false)
  best_selling        Boolean                 @default(false)
  created_at          DateTime                @default(now())
  category_id         String?
  category            Category?               @relation(fields: [category_id], references: [id], onDelete: Restrict)
  sku                 String?
  serial_number       String?
  color               String?
  shutter_count       String?
  is_deleted          Boolean                 @default(false)
  capital             Int
  strikethrough_price Int? // harga coret, opsional. Laba kamera = price - modal, dihitung saat dikirim ke client (tidak disimpan)
  images              CameraImage[]
  marketplaceLinks    CameraMarketplaceLink[]
  order_items         OrderItem[]
}

model CameraImage {
  id         String   @id @default(uuid())
  camera_id  String
  image_url  String   @db.Text
  is_primary Boolean  @default(false)
  created_at DateTime @default(now())

  camera Camera @relation(fields: [camera_id], references: [id], onDelete: Cascade)

  @@index([camera_id])
}

model Category {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())
  cameras    Camera[]
}

model Marketplace {
  id           String                  @id @default(uuid())
  logo_url     String
  name         String                  @unique
  is_active    Boolean                 @default(true)
  camera_links CameraMarketplaceLink[]
}

model CameraMarketplaceLink {
  id             String @id @default(uuid())
  camera_id      String
  marketplace_id String
  product_url    String @db.Text

  camera      Camera      @relation(fields: [camera_id], references: [id], onDelete: Cascade)
  marketplace Marketplace @relation(fields: [marketplace_id], references: [id], onDelete: Cascade)

  @@unique([camera_id, marketplace_id])
}

model Store {
  id                         String  @id @default(uuid())
  logo_url                   String
  name                       String
  instagram                  String?
  whatsapp                   String?
  tiktok                     String?
  facebook                   String?
  address                    String?
  map_url                    String?
  main_banner_url            String?
  terms_and_condition        String  @db.Text
  // false = absen boleh dari mana saja (saklar darurat kalau IP toko berubah)
  attendance_require_network Boolean @default(true)
}

model Banner {
  id             String   @id @default(uuid())
  banner_url     String
  created_at     DateTime @default(now())
  is_promo       Boolean  @default(false)
  is_best_seller Boolean  @default(false)
}

// -----------------------------------------------------------------------------
// ORDER
// Order bertipe SALE = penjualan. Order bertipe REFUND = pengembalian uang
// (refund_of_id menunjuk order asli). Semua nominal POSITIF; arti uang masuk
// atau keluar ditentukan oleh `type`.
//
// Pembayaran hanya dua status: UNPAID dan PAID (tanpa cicilan).
//   paid_at = kapan order ditandai lunas (null selama UNPAID).
// Status hanya boleh diubah oleh SATU fungsi service (setPaymentStatus),
// di dalam transaksi yang mengunci baris order (SELECT ... FOR UPDATE):
//   -> PAID   : paid_at = now() (kalau belum PAID)
//   -> UNPAID : paid_at = null
// Order REFUND dibuat langsung PAID dengan paid_at = tanggal uang dikembalikan.
// total_amount adalah angka FINAL (setelah diskon, TANPA ongkir) dan harus ikut
// diperbarui setiap kali invoice diedit.
// -----------------------------------------------------------------------------
model Order {
  id             String          @id @default(uuid())
  type           OrderType       @default(SALE)
  refund_of_id   String?
  refund_of      Order?          @relation("OrderRefunds", fields: [refund_of_id], references: [id], onDelete: Restrict)
  refunds        Order[]         @relation("OrderRefunds")
  customer_id    String?
  customer       Customer?       @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  customer_name  String
  total_amount   Int
  payment_status PaymentStatuses @default(UNPAID)
  paid_at        DateTime?
  created_at     DateTime        @default(now())
  address        String          @db.Text
  whatsapp       String
  dp_amount      Int?
  instagram      String?
  dp_paid_at     DateTime?
  order_items    OrderItem[]
  invoice        Invoice?

  @@index([customer_id])
  @@index([refund_of_id])
  @@index([type, payment_status, paid_at])
}

model OrderItem {
  id           String  @id @default(uuid())
  order_id     String
  camera_id    String
  quantity     Int     @default(1)
  camera_name  String
  camera_price Int // snapshot harga jual saat order
  camera_modal Int // snapshot modal saat order (dasar hitung laba)
  restocked    Boolean @default(false) // hanya dipakai di order REFUND: barang kembali ke stok
  order        Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  camera       Camera  @relation(fields: [camera_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([camera_id])
}

model Invoice {
  id                  String   @id @default(uuid())
  no_invoice          String   @unique
  store_name          String
  store_address       String?  @db.Text
  whatsapp_store      String?
  instagram_store     String?
  created_at          DateTime @default(now())
  payment_method      String?
  ship                String?
  customer_name       String
  customer_address    String   @db.Text
  customer_whatsapp   String
  customer_instagram  String?
  total_amount        Int
  order_id            String   @unique
  store_discount      Int?
  customer_discount   Int?
  is_final            Boolean  @default(false)
  order               Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  terms_and_condition String?

  @@index([created_at])
}

model Termsandcondition {
  id    String  @id @default(uuid())
  value String? @db.Text
}

// -----------------------------------------------------------------------------
// USER (login dashboard) dan EMPLOYEE (absen)
// Admin yang ikut absen = User + Employee (user_id terisi).
// Karyawan biasa = Employee dengan user_id null (tanpa akun login).
// -----------------------------------------------------------------------------
model User {
  id           String        @id @default(uuid())
  supabase_id  String        @unique
  name         String
  email        String        @unique
  role         Role          @default(ADMIN)
  is_active    Boolean       @default(true)
  employee     Employee?
  dailyReports DailyReport[]
}

model Employee {
  id                String             @id @default(uuid())
  display_id        String?
  name              String
  job_title         String?
  bank_name         String?
  account_number    String?
  account_holder    String?
  pin_hash          String? // null sampai karyawan membuat PIN lewat link verifikasi
  is_active         Boolean            @default(true)
  user_id           String?            @unique
  user              User?              @relation(fields: [user_id], references: [id], onDelete: SetNull)
  created_at        DateTime           @default(now())
  attendances       Attendance[]
  email             String             @unique
  email_verified_at DateTime?
  verify_token_hash String?
  verify_expires_at DateTime?
  verify_sent_at    DateTime?
  verify_attempts   Int                @default(0)
  pin_failed_count  Int                @default(0)
  pin_locked_until  DateTime?
  contracts         EmployeeContract[]
  payrolls          Payroll[]

  scheduleEmployees ScheduleEmployee[]
}

model EmployeeContract {
  id          String    @id @default(uuid())
  employee_id String
  employee    Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  start_date  DateTime  @db.Date
  end_date    DateTime? @db.Date
  note        String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([employee_id, start_date])
}

model Attendance {
  id              String    @id @default(uuid())
  employee_id     String
  employee        Employee  @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  check_in_at     DateTime
  check_out_at    DateTime?
  // true = karyawan lupa absen pulang (ditandai otomatis saat absen masuk hari berikutnya).
  // check_out_at tetap null; admin boleh mengisinya manual di rekap.
  missed_checkout Boolean   @default(false)

  @@index([employee_id, check_in_at])
}

// IP wifi toko yang boleh dipakai absen: IPv4 ("203.0.113.7") atau prefix
// ("203.0.113.0/24", IPv6 "2001:db8:1234:5678::/64"). Dikelola owner.
// Dicocokkan dengan req.ip di service (trust proxy harus diset PERSIS sesuai
// jumlah proxy hosting, jangan `true`, supaya header X-Forwarded-For palsu tidak lolos).
model AttendanceNetwork {
  id         String   @id @default(uuid())
  cidr       String   @unique
  label      String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
}

// id dibuat di service: "cust-" + 5 karakter (A-Z tanpa I/O, angka 2-9)
model Customer {
  id         String   @id
  name       String
  whatsapp   String   @unique // dinormalkan dulu (0812.. / +62812.. / 62812.. = satu bentuk)
  instagram  String?
  address    String   @db.Text
  created_at DateTime @default(now())
  orders     Order[]
}

model Payroll {
  id                String        @id @default(uuid())
  employee_id       String?
  employee          Employee?     @relation(fields: [employee_id], references: [id], onDelete: SetNull)
  employee_name     String
  job_title         String
  bank_name         String
  account_number    String
  account_holder    String
  disbursement_date DateTime      @db.Date
  status            PayrollStatus @default(PENDING)
  total_amount      Int
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  items             PayrollItem[]

  @@index([employee_id])
  @@index([status, disbursement_date])
}

// Satu baris penerimaan (gaji pokok, insentif, dst.)
model PayrollItem {
  id         String  @id @default(uuid())
  payroll_id String
  payroll    Payroll @relation(fields: [payroll_id], references: [id], onDelete: Cascade)
  name       String
  note       String?
  checked    Boolean @default(false)
  amount     Int
  sort_order Int

  @@index([payroll_id])
}

model QcItem {
  id         String                @id @default(uuid())
  section    QcSection
  name       String
  is_active  Boolean               @default(true)
  sort_order Int                   @default(0)
  created_at DateTime              @default(now())
  updated_at DateTime              @updatedAt
  entries    QualityControlEntry[]

  @@unique([section, name])
  @@index([section, sort_order])
}

model QualityControl {
  id              String                @id @default(uuid())
  date            DateTime              @db.Date
  type            QcType
  status          QcStatus
  product_name    String
  serial_number   String?
  sku             String?
  sender_name     String?
  tracking_number String?
  pic             String?
  price           Int?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  entries         QualityControlEntry[]
  extras          QualityControlExtra[]
  media           QualityControlMedia[]

  @@index([date])
  @@index([status])
}

model QualityControlEntry {
  id             String         @id @default(uuid())
  qc_id          String
  qc             QualityControl @relation(fields: [qc_id], references: [id], onDelete: Cascade)
  item_id        String?
  item           QcItem?        @relation(fields: [item_id], references: [id], onDelete: SetNull)
  section        QcSection
  name           String
  checked        Boolean?
  classification QcClass?
  origin         QcOrigin?
  note           String?
  sort_order     Int            @default(0)

  @@index([qc_id, sort_order])
  @@index([item_id])
}

model QualityControlExtra {
  id         String         @id @default(uuid())
  qc_id      String
  qc         QualityControl @relation(fields: [qc_id], references: [id], onDelete: Cascade)
  name       String
  sort_order Int            @default(0)

  @@index([qc_id, sort_order])
}

model QualityControlMedia {
  id           String         @id @default(uuid())
  qc_id        String
  qc           QualityControl @relation(fields: [qc_id], references: [id], onDelete: Cascade)
  kind         QcMediaKind
  path         String         @unique
  content_type String
  size         Int
  created_at   DateTime       @default(now())

  @@index([qc_id])
}

// Tambahkan ke model User:
//   daily_reports DailyReport[]
model DailyReport {
  id                 String             @id @default(uuid())
  date               DateTime           @unique @db.Date
  pic                String
  pic_employee_id    String?
  pic_display_id     String?
  opening_cash       Int
  opening_noncash    Int
  remit_cash         Int?
  remit_transfer     Int?
  remitted           Boolean            @default(false)
  remitted_at        DateTime?
  proof_path         String?            @unique
  proof_content_type String?
  proof_size         Int?
  proof_uploaded_at  DateTime?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  entries            DailyReportEntry[]
  logs               DailyReportLog[]
  user               User?              @relation(fields: [userId], references: [id])
  userId             String?
}

model DailyReportEntry {
  id         String      @id @default(uuid())
  seq        Int         @default(autoincrement())
  report_id  String
  report     DailyReport @relation(fields: [report_id], references: [id], onDelete: Cascade)
  method     EntryMethod
  name       String
  note       String?
  income     Int         @default(0)
  expense    Int         @default(0)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  @@index([report_id, seq])
}

model DailyReportLog {
  id         String      @id @default(uuid())
  seq        Int         @default(autoincrement())
  report_id  String
  report     DailyReport @relation(fields: [report_id], references: [id], onDelete: Cascade)
  user_id    String
  user_name  String
  user_role  String
  action     String
  detail     Json?
  created_at DateTime    @default(now())

  @@index([report_id, seq])
}

// IP wifi toko yang dilaporkan sendiri oleh perangkat toko (PC) lewat heartbeat.
// token_hash = sha256 dari token rahasia (token asli hanya tampil sekali saat dibuat).
// ip_v4 = alamat IPv4 ("203.0.113.7"), ip_v6 = prefix /64 ("2001:db8:1:2::/64").
// Tanpa relasi ke tabel lain.
model AttendanceDevice {
  id            String    @id @default(uuid())
  label         String
  token_hash    String    @unique
  is_active     Boolean   @default(true)
  ip_v4         String?
  ip_v6         String?
  last_seen_at  DateTime?
  ip_changed_at DateTime?
  created_at    DateTime  @default(now())
}

model ScheduleItem {
  id              String               @id @default(uuid())
  code            String               @unique @db.VarChar(10) // "P", "AL", "OFF"
  name            String               @db.VarChar(100) // "Shift Pagi"
  category        ScheduleItemCategory @default(SHIFT)
  start_time      String?              @db.VarChar(5) // "09:00"
  end_time        String?              @db.VarChar(5) // "17:00"
  color           String               @default("#FFFFFF") @db.VarChar(7) // warna latar sel
  text_color      String               @default("#000000") @db.VarChar(7) // warna teks sel
  show_in_summary Boolean              @default(false) // tampil di kolom rekap kanan (OFF/PIK/AL)
  sort_order      Int                  @default(0)
  is_active       Boolean              @default(true)
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  entries         ScheduleEntry[]

  @@map("schedule_items")
}

// Header jadwal: 1 jadwal = 1 bulan
model Schedule {
  id         String             @id @default(uuid())
  month      String             @unique @db.VarChar(7) // "2026-12"
  title      String             @db.VarChar(150) // "SCHEDULE DESEMBER 2026"
  notes      String?            @db.Text
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  employees  ScheduleEmployee[]

  @@map("schedules")
}

// Baris tabel: karyawan yang ikut dalam suatu jadwal
model ScheduleEmployee {
  id          String          @id @default(uuid())
  schedule_id String
  employee_id String
  sort_order  Int             @default(0)
  created_at  DateTime        @default(now())
  schedule    Schedule        @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  employee    Employee        @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  entries     ScheduleEntry[]

  @@unique([schedule_id, employee_id])
  @@map("schedule_employees")
}

// Isi sel: 1 karyawan x 1 tanggal = 1 item. Sel kosong = tidak ada baris.
model ScheduleEntry {
  id                   String           @id @default(uuid())
  schedule_employee_id String
  date                 DateTime         @db.Date
  schedule_item_id     String
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  scheduleEmployee     ScheduleEmployee @relation(fields: [schedule_employee_id], references: [id], onDelete: Cascade)
  item                 ScheduleItem     @relation(fields: [schedule_item_id], references: [id], onDelete: Restrict)

  @@unique([schedule_employee_id, date])
  @@index([schedule_item_id])
  @@map("schedule_entries")
}
